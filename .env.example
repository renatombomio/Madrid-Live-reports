# ─── Database ──────────────────────────────────────────────────────────────────
# Used by the app and drizzle-kit. Docker Compose sets up this DB automatically.
DATABASE_URL=postgresql://madrid:madrid123@localhost:5432/madrid_live_reports

# Disposable database for integration tests — created automatically on first run.
TEST_DATABASE_URL=postgresql://madrid:madrid123@localhost:5432/madrid_live_test

# ─── Authentication (better-auth) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4321

# ─── App ───────────────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:4321
NODE_ENV=development

# ─── E2E tests (Playwright) ────────────────────────────────────────────────────
# The global setup creates this user via sign-up API and promotes to admin.
E2E_ADMIN_EMAIL=e2e-admin@madridlive.test
E2E_ADMIN_PASSWORD=E2eAdmin!2026
