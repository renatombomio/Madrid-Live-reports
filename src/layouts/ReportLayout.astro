---
import PublicDashboardLayout from './PublicDashboardLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import type { reports } from '../db/schema';
import type { InferSelectModel } from 'drizzle-orm';
import { CATEGORY_LABELS } from '../lib/content-labels';
import { fmtRelative } from '../lib/format';

type Report = InferSelectModel<typeof reports>;

interface RelatedReport {
  title: string; slug: string; summary: string;
  publishedAt: Date | null; districtName?: string | null;
}

interface Props {
  report: Report & { authorName: string; districtName?: string | null };
  relatedByCategory?: RelatedReport[];
}

const { report, relatedByCategory = [] } = Astro.props;

const formattedDate = report.publishedAt
  ? new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' }).format(report.publishedAt)
  : null;

const categoryLabel = CATEGORY_LABELS[report.category] ?? report.category;
---

<PublicDashboardLayout
  title={report.title}
  description={report.summary}
  ogImage={report.coverImage ?? undefined}
  showTicker={false}
>
  <div class="article-layout">
    <article class="article">
      {report.coverImage && (
        <img src={report.coverImage} alt={report.title} class="article__cover" />
      )}
      <div class="article__body">
        <nav class="article__breadcrumb syne" aria-label="Navegación de ruta">
          <a href="/">Madrid Live</a>
          <span aria-hidden="true">/</span>
          <a href="/reports">Reportes</a>
          <span aria-hidden="true">/</span>
          <span>{report.title.length > 40 ? report.title.slice(0, 40) + '…' : report.title}</span>
        </nav>

        <div class="article__meta">
          <span class="article__cat syne">{categoryLabel}</span>
          {report.districtName && <span class="article__district">{report.districtName}</span>}
          {formattedDate && <time class="article__date">{formattedDate}</time>}
        </div>

        <h1 class="article__title syne">{report.title}</h1>
        <p class="article__summary">{report.summary}</p>
        <p class="article__byline">Por {report.authorName}</p>

        <div class="article-content" set:html={report.content} />

        {relatedByCategory.length > 0 && (
          <aside class="related" aria-label={`Más reportes sobre ${categoryLabel}`}>
            <div class="related__head syne">Más en {categoryLabel}</div>
            <ul class="related__list">
              {relatedByCategory.map(r => (
                <li>
                  <a href={`/reports/${r.slug}`} class="related-item">
                    <span class="related-item__title">{r.title}</span>
                    <span class="related-item__meta">
                      {r.districtName && <span>{r.districtName}</span>}
                      {r.publishedAt  && <time>{fmtRelative(r.publishedAt)}</time>}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}

        <div class="article__back">
          <a href="/reports">← Volver a reportes</a>
        </div>
      </div>
    </article>
    <Sidebar />
  </div>
</PublicDashboardLayout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    border-top: 1px solid var(--border);
    min-height: 60vh;
  }
  .article { border-right: 1px solid var(--border); }
  .article__cover { width: 100%; max-height: 360px; object-fit: cover; }
  .article__body { padding: 2.5rem 2rem; max-width: 720px; }

  .article__breadcrumb {
    display: flex; align-items: center; gap: 8px;
    font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--txt3); margin-bottom: 1.75rem;
  }
  .article__breadcrumb a { color: var(--txt3); text-decoration: none; transition: color 0.15s; }
  .article__breadcrumb a:hover { color: var(--accent); }

  .article__meta {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .article__cat {
    background: var(--accentbg); border: 1px solid var(--accentbd); color: var(--accent);
    font-family: 'Syne', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 8px; border-radius: 4px;
  }
  .article__district {
    background: var(--bg4); border: 1px solid var(--border2); border-radius: 4px;
    padding: 2px 7px; font-size: 10px; color: var(--txt2);
    font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: 0.04em;
  }
  .article__date { font-size: 12px; color: var(--txt3); }

  .article__title {
    font-size: clamp(22px, 3.5vw, 34px); font-weight: 800;
    letter-spacing: -0.5px; color: var(--txt);
    margin-bottom: 1rem; line-height: 1.2;
  }
  .article__summary {
    font-size: 16px; font-weight: 300; color: var(--txt2);
    line-height: 1.75; margin-bottom: 0.5rem;
    border-left: 3px solid var(--border2); padding-left: 1rem;
  }
  .article__byline { font-size: 12px; color: var(--txt3); margin-bottom: 2.5rem; }

  .related {
    margin-top: 3rem; border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }
  .related__head {
    font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--txt3); margin-bottom: 0.875rem;
  }
  .related__list { list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .related-item {
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
    padding: 0.55rem 0; border-bottom: 1px solid var(--border);
    text-decoration: none; transition: background 0.15s;
  }
  .related-item:last-child { border-bottom: none; }
  .related-item:hover .related-item__title { color: var(--accent); }
  .related-item__title {
    font-size: 13px; font-weight: 600; color: var(--txt); line-height: 1.4;
    transition: color 0.15s; flex: 1;
  }
  .related-item__meta {
    display: flex; gap: 8px; align-items: center; flex-shrink: 0;
    font-size: 11px; color: var(--txt3); white-space: nowrap;
  }

  .article__back {
    margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
  }
  .article__back a {
    font-size: 13px; color: var(--txt3); text-decoration: none; transition: color 0.15s;
  }
  .article__back a:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .article-layout { grid-template-columns: 1fr; }
    .article { border-right: none; }
    .article__body { padding: 2rem 1.25rem; }
  }
</style>
