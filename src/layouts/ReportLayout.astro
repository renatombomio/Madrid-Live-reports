---
import BaseLayout from './BaseLayout.astro';
import type { reports } from '../db/schema';
import type { InferSelectModel } from 'drizzle-orm';

type Report = InferSelectModel<typeof reports>;

interface Props {
  report: Report & { authorName: string; districtName?: string };
}

const { report } = Astro.props;
const formattedDate = report.publishedAt
  ? new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' }).format(report.publishedAt)
  : null;
---

<BaseLayout title={report.title} description={report.summary} ogImage={report.coverImage ?? undefined}>
  <article class="max-w-3xl mx-auto">
    {report.coverImage && (
      <img
        src={report.coverImage}
        alt={report.title}
        class="w-full h-64 object-cover rounded-card mb-8"
      />
    )}

    <header class="mb-8">
      <div class="flex items-center gap-2 text-sm text-gray-500 mb-3">
        <span class="bg-madrid-red text-white px-2 py-0.5 rounded text-xs font-medium uppercase tracking-wide">
          {report.category.replace('_', ' ')}
        </span>
        {report.districtName && (
          <span class="text-gray-400">·</span>
          <span>{report.districtName}</span>
        )}
        {formattedDate && (
          <span class="text-gray-400">·</span>
          <time datetime={report.publishedAt?.toISOString()}>{formattedDate}</time>
        )}
      </div>

      <h1 class="text-4xl font-bold leading-tight mb-4">{report.title}</h1>
      <p class="text-xl text-gray-600 leading-relaxed">{report.summary}</p>
      <p class="mt-3 text-sm text-gray-400">Por {report.authorName}</p>
    </header>

    <div class="prose prose-lg max-w-none" set:html={report.content} />
  </article>
</BaseLayout>
