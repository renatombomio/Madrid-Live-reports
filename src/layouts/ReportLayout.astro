---
import PublicDashboardLayout from './PublicDashboardLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import type { reports } from '../db/schema';
import type { InferSelectModel } from 'drizzle-orm';
import { CATEGORY_LABELS } from '../lib/content-labels';

type Report = InferSelectModel<typeof reports>;

interface Props {
  report: Report & { authorName: string; districtName?: string };
}

const { report } = Astro.props;
const formattedDate = report.publishedAt
  ? new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' }).format(report.publishedAt)
  : null;

const categoryLabel = CATEGORY_LABELS[report.category] ?? report.category;
---

<PublicDashboardLayout
  title={report.title}
  description={report.summary}
  ogImage={report.coverImage ?? undefined}
  showTicker={false}
>
  <div class="article-layout">
    <article class="article">
      {report.coverImage && (
        <img src={report.coverImage} alt={report.title} class="article__cover" />
      )}
      <div class="article__body">
        <div class="article__meta">
          <span class="article__cat syne">{categoryLabel}</span>
          {report.districtName && <span class="article__district">{report.districtName}</span>}
          {formattedDate && <time class="article__date">{formattedDate}</time>}
        </div>
        <h1 class="article__title syne">{report.title}</h1>
        <p class="article__summary">{report.summary}</p>
        <p class="article__byline">Por {report.authorName}</p>
        <div class="article-content" set:html={report.content} />
      </div>
    </article>
    <Sidebar />
  </div>
</PublicDashboardLayout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    border-top: 1px solid var(--border);
    min-height: 60vh;
  }
  .article {
    border-right: 1px solid var(--border);
  }
  .article__cover {
    width: 100%;
    height: 300px;
    object-fit: cover;
  }
  .article__body {
    padding: 2rem 1.5rem;
  }
  .article__meta {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .article__cat {
    background: var(--accentbg);
    border: 1px solid var(--accentbd);
    color: var(--accent);
    font-family: 'Syne', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 4px;
  }
  .article__district {
    background: var(--bg4);
    border: 1px solid var(--border2);
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 10px;
    color: var(--txt2);
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .article__date {
    font-size: 12px;
    color: var(--txt3);
  }
  .article__title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--txt);
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .article__summary {
    font-size: 15px;
    font-weight: 300;
    color: var(--txt2);
    line-height: 1.75;
    margin-bottom: 0.75rem;
  }
  .article__byline {
    font-size: 12px;
    color: var(--txt3);
    margin-bottom: 2rem;
  }
  @media (max-width: 900px) {
    .article-layout { grid-template-columns: 1fr; }
    .article { border-right: none; border-bottom: 1px solid var(--border); }
  }
</style>
