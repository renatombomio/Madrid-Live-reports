---
interface Props {
  title: string;
  user?: { name: string; role?: string | null };
}
const { title, user } = Astro.props;
const path = Astro.url.pathname;
const navActive = (href: string) =>
  href === '/admin' ? path === '/admin' : path.startsWith(href);
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Admin · Madrid Live</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="adm-body">

  <nav class="adm-bar" aria-label="Navegación admin">
    <div class="adm-bar__left">
      <a href="/admin" class="adm-logo">
        MADRIDLIVE
        <span class="adm-logo__tag">ADMIN</span>
      </a>
      <div class="adm-nav">
        <a href="/admin"         class:list={['adm-nav__link', { active: navActive('/admin') }]}>Dashboard</a>
        <a href="/admin/reports" class:list={['adm-nav__link', { active: navActive('/admin/reports') }]}>Reportes</a>
      </div>
    </div>
    <div class="adm-bar__right">
      <a href="/" class="adm-viewsite" target="_blank" rel="noopener">Ver sitio →</a>
      {user && <span class="adm-username">{user.name}</span>}
      <form method="POST" action="/api/auth/sign-out" style="display:contents">
        <button type="submit" class="adm-signout">Salir</button>
      </form>
    </div>
  </nav>

  <main class="adm-main">
    <slot />
  </main>

  <!-- ── Toast container ──────────────────────────────────────────────────── -->
  <div id="adm-toasts" aria-live="polite" aria-atomic="false"></div>

  <!-- ── Command palette ──────────────────────────────────────────────────── -->
  <div id="cmd-backdrop" class="cmd-backdrop" hidden aria-modal="true" role="dialog" aria-label="Paleta de comandos">
    <div class="cmd-modal">
      <div class="cmd-search-row">
        <svg class="cmd-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input id="cmd-input" class="cmd-input" type="search" placeholder="Buscar reportes o ir a…" autocomplete="off" spellcheck="false" />
        <kbd class="cmd-esc">Esc</kbd>
      </div>
      <div id="cmd-list" class="cmd-list" role="listbox">
        <div class="cmd-section">Acciones rápidas</div>
        <a href="/admin/reports/new" class="cmd-item" role="option" data-idx="0">
          <span class="cmd-item__icon">+</span>
          <span class="cmd-item__label">Nuevo reporte</span>
          <kbd class="cmd-hint">N</kbd>
        </a>
        <a href="/admin/reports" class="cmd-item" role="option" data-idx="1">
          <span class="cmd-item__icon">▤</span>
          <span class="cmd-item__label">Lista de reportes</span>
        </a>
        <a href="/admin" class="cmd-item" role="option" data-idx="2">
          <span class="cmd-item__icon">⊞</span>
          <span class="cmd-item__label">Dashboard</span>
        </a>
        <a href="/" target="_blank" class="cmd-item" role="option" data-idx="3">
          <span class="cmd-item__icon">↗</span>
          <span class="cmd-item__label">Ver sitio público</span>
        </a>
        <div id="cmd-dynamic"></div>
      </div>
    </div>
  </div>

</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --adm-bg:       #f9f8f6;
    --adm-bg2:      #ffffff;
    --adm-bg3:      #f4f2ee;
    --adm-bg4:      #edeae4;
    --adm-border:   #e8e4db;
    --adm-border2:  #d5cfc4;
    --adm-txt:      #1a1714;
    --adm-txt2:     #5a5550;
    --adm-txt3:     #9b8c7e;
    --adm-accent:   #c56b2d;
    --adm-accentbg: #fdf3eb;
    --adm-accentbd: #f0c9a0;
    --adm-green:    #166534;
    --adm-greenbg:  #f0fdf4;
    --adm-greenbd:  #86efac;
    --adm-amber:    #92400e;
    --adm-amberbg:  #fffbeb;
    --adm-amberbd:  #fde68a;
    --adm-red:      #991b1b;
    --adm-redbg:    #fef2f2;
    --adm-redbd:    #fca5a5;
    --adm-radius:   6px;
    --adm-shadow:   0 1px 3px rgba(0,0,0,0.06);
  }

  .adm-body {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    background: var(--adm-bg);
    color: var(--adm-txt);
    min-height: 100vh;
  }

  /* ── Top bar ──────────────────────────────────────────────────────────────── */
  .adm-bar {
    position: sticky; top: 0; z-index: 100;
    background: var(--adm-bg2);
    border-bottom: 1px solid var(--adm-border);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 1.5rem; height: 52px;
    box-shadow: var(--adm-shadow);
  }
  .adm-bar__left  { display: flex; align-items: center; gap: 2rem; }
  .adm-bar__right { display: flex; align-items: center; gap: 1rem; }

  .adm-logo {
    font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 800;
    letter-spacing: 0.1em; color: var(--adm-txt); text-decoration: none;
    display: flex; align-items: center; gap: 8px; white-space: nowrap;
  }
  .adm-logo__tag {
    font-size: 8px; font-weight: 700; letter-spacing: 0.1em;
    background: var(--adm-accent); color: #fff;
    border-radius: 3px; padding: 2px 5px;
  }

  .adm-nav { display: flex; }
  .adm-nav__link {
    font-size: 12px; font-weight: 500; color: var(--adm-txt2);
    text-decoration: none; padding: 0 10px; line-height: 50px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .adm-nav__link:hover { color: var(--adm-txt); }
  .adm-nav__link.active { color: var(--adm-accent); border-bottom-color: var(--adm-accent); }

  .adm-viewsite {
    font-size: 11px; color: var(--adm-txt3); text-decoration: none;
    transition: color 0.15s; white-space: nowrap;
  }
  .adm-viewsite:hover { color: var(--adm-accent); }
  .adm-username { font-size: 12px; color: var(--adm-txt2); white-space: nowrap; }
  .adm-signout {
    font-size: 11px; color: var(--adm-txt3);
    background: none; border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius); padding: 4px 10px;
    cursor: pointer; transition: color 0.15s, border-color 0.15s;
    font-family: inherit;
  }
  .adm-signout:hover { color: var(--adm-txt); border-color: var(--adm-border2); }

  /* ── Main ────────────────────────────────────────────────────────────────── */
  .adm-main { padding: 2rem 1.5rem; max-width: 1140px; margin: 0 auto; }

  /* ── Page header ─────────────────────────────────────────────────────────── */
  .adm-page-header { margin-bottom: 2rem; }
  .adm-breadcrumb {
    font-family: 'Syne', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--adm-txt3);
    display: flex; align-items: center; gap: 7px; margin-bottom: 0.75rem;
  }
  .adm-breadcrumb a { color: var(--adm-txt3); text-decoration: none; transition: color 0.15s; }
  .adm-breadcrumb a:hover { color: var(--adm-accent); }
  .adm-breadcrumb span[aria-hidden] { opacity: 0.4; }
  .adm-page-title {
    font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800;
    letter-spacing: -0.3px; color: var(--adm-txt);
  }

  /* ── Stat card ───────────────────────────────────────────────────────────── */
  .adm-stat {
    background: var(--adm-bg2); border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius); padding: 1.25rem 1.5rem;
    box-shadow: var(--adm-shadow);
  }
  .adm-stat__value {
    font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 800;
    color: var(--adm-txt); line-height: 1; margin-bottom: 0.375rem;
  }
  .adm-stat__value--accent { color: var(--adm-accent); }
  .adm-stat__value--green  { color: var(--adm-green); }
  .adm-stat__value--amber  { color: var(--adm-amber); }
  .adm-stat__label { font-size: 11px; color: var(--adm-txt3); letter-spacing: 0.03em; }
  .adm-stat__sub   { font-size: 10px; color: var(--adm-txt3); margin-top: 4px; }

  /* ── Panel block ─────────────────────────────────────────────────────────── */
  .adm-panel {
    background: var(--adm-bg2); border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius); box-shadow: var(--adm-shadow); overflow: hidden;
  }
  .adm-panel__head {
    font-family: 'Syne', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--adm-txt3);
    padding: 0.875rem 1.25rem 0.625rem;
    border-bottom: 1px solid var(--adm-border);
    display: flex; align-items: center; justify-content: space-between;
  }
  .adm-panel__head a { color: var(--adm-accent); font-size: 11px; text-transform: none; text-decoration: none; letter-spacing: 0; }
  .adm-panel__head a:hover { opacity: 0.75; }

  /* ── Status badges ───────────────────────────────────────────────────────── */
  .adm-badge {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 10px; font-weight: 600; letter-spacing: 0.03em;
    padding: 2px 8px; border-radius: 10px; border: 1px solid;
  }
  .adm-badge--published { color: var(--adm-green);  background: var(--adm-greenbg);  border-color: var(--adm-greenbd); }
  .adm-badge--draft     { color: var(--adm-amber);  background: var(--adm-amberbg);  border-color: var(--adm-amberbd); }
  .adm-badge--archived  { color: var(--adm-txt3);   background: var(--adm-bg3);      border-color: var(--adm-border); }
  .adm-badge__dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }

  /* ── Primary action button ───────────────────────────────────────────────── */
  .adm-btn {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: 'Syne', sans-serif; font-size: 11px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    background: var(--adm-accent); color: #fff; text-decoration: none;
    border: none; border-radius: var(--adm-radius); padding: 8px 16px;
    cursor: pointer; transition: opacity 0.15s; white-space: nowrap;
  }
  .adm-btn:hover { opacity: 0.85; color: #fff; }
  .adm-btn--sm { font-size: 10px; padding: 5px 10px; }
  .adm-btn--ghost {
    background: none; color: var(--adm-txt2); border: 1px solid var(--adm-border);
  }
  .adm-btn--ghost:hover { color: var(--adm-txt); border-color: var(--adm-border2); background: none; opacity: 1; }

  /* ── Table ───────────────────────────────────────────────────────────────── */
  .adm-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .adm-table thead { border-bottom: 1px solid var(--adm-border); background: var(--adm-bg3); }
  .adm-table th {
    text-align: left; padding: 0.625rem 1rem;
    font-family: 'Syne', sans-serif; font-size: 9px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--adm-txt3);
  }
  .adm-table td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--adm-border); vertical-align: middle; }
  .adm-table tbody tr:last-child td { border-bottom: none; }
  .adm-table tbody tr { transition: background 0.12s; }
  .adm-table tbody tr:hover { background: var(--adm-bg3); }

  /* ── Filter tabs ─────────────────────────────────────────────────────────── */
  .adm-tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--adm-border); margin-bottom: 0; }
  .adm-tab {
    font-size: 12px; font-weight: 500; color: var(--adm-txt2);
    text-decoration: none; padding: 10px 14px;
    border-bottom: 2px solid transparent; margin-bottom: -1px;
    transition: color 0.15s, border-color 0.15s; white-space: nowrap;
  }
  .adm-tab:hover { color: var(--adm-txt); }
  .adm-tab.active { color: var(--adm-accent); border-bottom-color: var(--adm-accent); }
  .adm-tab__count {
    font-size: 10px; font-weight: 700; font-family: 'Syne', sans-serif;
    background: var(--adm-bg4); color: var(--adm-txt3);
    border-radius: 8px; padding: 1px 6px; margin-left: 4px;
  }
  .adm-tab.active .adm-tab__count { background: var(--adm-accentbg); color: var(--adm-accent); }

  /* ── Inline action links ─────────────────────────────────────────────────── */
  .adm-action {
    font-size: 11px; color: var(--adm-txt3); text-decoration: none;
    padding: 3px 7px; border-radius: 4px; border: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
    white-space: nowrap; cursor: pointer; background: none;
    font-family: inherit; font-size: 11px;
  }
  .adm-action:hover { color: var(--adm-txt); border-color: var(--adm-border); background: var(--adm-bg3); }
  .adm-action--publish { color: var(--adm-accent); }
  .adm-action--publish:hover { border-color: var(--adm-accentbd); background: var(--adm-accentbg); color: var(--adm-accent); }
  .adm-action--danger:hover  { color: var(--adm-red);   border-color: var(--adm-redbd);   background: var(--adm-redbg); }

  /* ── Empty state ─────────────────────────────────────────────────────────── */
  .adm-empty {
    padding: 3.5rem 1.5rem; text-align: center;
    border: 1px dashed var(--adm-border2); border-radius: var(--adm-radius);
  }
  .adm-empty__msg  { font-size: 13px; color: var(--adm-txt3); margin-bottom: 1rem; }

  /* ── Signal row (editorial signals) ─────────────────────────────────────── */
  .adm-signal-row {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--adm-border);
    transition: background 0.12s;
  }
  .adm-signal-row:last-child { border-bottom: none; }
  .adm-signal-row:hover { background: var(--adm-bg3); }
  .adm-signal-icon { font-size: 12px; flex-shrink: 0; margin-top: 1px; }
  .adm-signal-body { flex: 1; min-width: 0; }
  .adm-signal-label { font-size: 12px; color: var(--adm-txt2); line-height: 1.4; }
  .adm-signal-label a { color: var(--adm-txt2); text-decoration: none; }
  .adm-signal-label a:hover { color: var(--adm-accent); }
  .adm-signal-meta  { font-size: 11px; color: var(--adm-txt3); margin-top: 1px; }

  /* ── Activity row ────────────────────────────────────────────────────────── */
  .adm-activity-row {
    display: flex; align-items: center; gap: 12px;
    padding: 0.65rem 1.25rem; border-bottom: 1px solid var(--adm-border);
    text-decoration: none; transition: background 0.12s;
  }
  .adm-activity-row:last-child { border-bottom: none; }
  .adm-activity-row:hover { background: var(--adm-bg3); }
  .adm-activity-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--adm-accent); flex-shrink: 0;
  }
  .adm-activity-title { font-size: 12px; color: var(--adm-txt); font-weight: 500; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .adm-activity-meta  { font-size: 11px; color: var(--adm-txt3); white-space: nowrap; flex-shrink: 0; }

  /* ── Category bar ────────────────────────────────────────────────────────── */
  .adm-catbar-row {
    display: flex; align-items: center; gap: 12px;
    padding: 0.6rem 1.25rem; border-bottom: 1px solid var(--adm-border);
  }
  .adm-catbar-row:last-child { border-bottom: none; }
  .adm-catbar-name { font-size: 12px; color: var(--adm-txt2); width: 110px; flex-shrink: 0; }
  .adm-catbar-track { flex: 1; height: 4px; background: var(--adm-border); border-radius: 2px; }
  .adm-catbar-fill  { height: 100%; border-radius: 2px; background: var(--adm-accent); }
  .adm-catbar-count { font-family: 'Syne', sans-serif; font-size: 11px; font-weight: 700; color: var(--adm-txt3); width: 24px; text-align: right; flex-shrink: 0; }

  /* ── Toast system ────────────────────────────────────────────────────────── */
  #adm-toasts {
    position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 9000;
    display: flex; flex-direction: column; gap: 8px; pointer-events: none;
  }
  .adm-toast {
    font-size: 13px; padding: 10px 16px; border-radius: var(--adm-radius);
    box-shadow: 0 4px 16px rgba(0,0,0,0.18); pointer-events: auto;
    opacity: 1; transform: translateY(0); transition: opacity 0.25s, transform 0.25s;
    max-width: 320px; line-height: 1.4;
  }
  .adm-toast--success { background: var(--adm-green); color: #fff; }
  .adm-toast--error   { background: var(--adm-red);   color: #fff; }
  .adm-toast--info    { background: var(--adm-txt);   color: #fff; }
  .adm-toast--out     { opacity: 0; transform: translateY(6px); }

  /* ── Command palette ─────────────────────────────────────────────────────── */
  .cmd-backdrop {
    position: fixed; inset: 0; z-index: 8000;
    background: rgba(26, 23, 20, 0.45); backdrop-filter: blur(2px);
    display: flex; align-items: flex-start; justify-content: center;
    padding-top: 12vh;
  }
  .cmd-backdrop[hidden] { display: none; }
  .cmd-modal {
    width: 100%; max-width: 560px; background: var(--adm-bg2);
    border: 1px solid var(--adm-border2); border-radius: 10px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.22); overflow: hidden;
    margin: 0 1rem;
  }
  .cmd-search-row {
    display: flex; align-items: center; gap: 10px;
    padding: 14px 16px; border-bottom: 1px solid var(--adm-border);
  }
  .cmd-search-icon { color: var(--adm-txt3); flex-shrink: 0; }
  .cmd-input {
    flex: 1; background: none; border: none; outline: none;
    font-size: 15px; font-family: 'Inter', sans-serif; color: var(--adm-txt);
  }
  .cmd-input::placeholder { color: var(--adm-txt3); }
  .cmd-esc {
    font-size: 10px; color: var(--adm-txt3); background: var(--adm-bg3);
    border: 1px solid var(--adm-border); border-radius: 4px; padding: 2px 6px;
    font-family: inherit; flex-shrink: 0;
  }
  .cmd-list { max-height: 340px; overflow-y: auto; padding: 6px 0; }
  .cmd-section {
    font-family: 'Syne', sans-serif; font-size: 9px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--adm-txt3);
    padding: 8px 16px 4px;
  }
  .cmd-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 16px; text-decoration: none; color: var(--adm-txt);
    transition: background 0.1s; cursor: pointer; border-radius: 0;
  }
  .cmd-item:hover,
  .cmd-item.focused { background: var(--adm-bg3); }
  .cmd-item__icon {
    width: 20px; text-align: center; font-size: 12px; color: var(--adm-txt3); flex-shrink: 0;
  }
  .cmd-item__dot {
    width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
  }
  .cmd-item__dot--published { background: var(--adm-green); }
  .cmd-item__dot--draft     { background: var(--adm-amber); }
  .cmd-item__dot--archived  { background: var(--adm-txt3); }
  .cmd-item__label { flex: 1; font-size: 13px; }
  .cmd-item__meta  { font-size: 11px; color: var(--adm-txt3); }
  .cmd-hint {
    font-size: 10px; color: var(--adm-txt3); background: var(--adm-bg3);
    border: 1px solid var(--adm-border); border-radius: 3px; padding: 1px 5px;
    font-family: inherit;
  }
  .cmd-empty { padding: 1.5rem; text-align: center; font-size: 13px; color: var(--adm-txt3); }

  /* ── Bulk action bar ─────────────────────────────────────────────────────── */
  #bulk-bar {
    position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%) translateY(80px);
    background: var(--adm-txt); color: #fff; border-radius: 8px;
    display: flex; align-items: center; gap: 8px; padding: 10px 16px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.22); z-index: 500;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    white-space: nowrap;
  }
  #bulk-bar.visible { transform: translateX(-50%) translateY(0); }
  .bulk-count { font-size: 12px; font-weight: 600; opacity: 0.8; margin-right: 4px; }
  .bulk-action {
    font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 5px;
    border: 1px solid rgba(255,255,255,0.25); background: none; color: #fff;
    cursor: pointer; transition: background 0.15s; font-family: inherit;
  }
  .bulk-action:hover { background: rgba(255,255,255,0.15); }
  .bulk-action--publish { border-color: var(--adm-greenbd); color: #86efac; }
  .bulk-action--publish:hover { background: rgba(134,239,172,0.12); }
  .bulk-dismiss {
    font-size: 18px; line-height: 1; background: none; border: none; color: rgba(255,255,255,0.5);
    cursor: pointer; padding: 0 2px; margin-left: 4px; transition: color 0.15s; font-family: inherit;
  }
  .bulk-dismiss:hover { color: #fff; }
</style>

<script>
  // ── Toast system ────────────────────────────────────────────────────────────
  function toast(msg: string, type: 'success' | 'error' | 'info' = 'success') {
    const container = document.getElementById('adm-toasts')!;
    const el = document.createElement('div');
    el.className = `adm-toast adm-toast--${type}`;
    el.textContent = msg;
    container.appendChild(el);
    setTimeout(() => {
      el.classList.add('adm-toast--out');
      setTimeout(() => el.remove(), 280);
    }, 3200);
  }
  (window as any).toast = toast;

  // ── Command palette ─────────────────────────────────────────────────────────
  const backdrop = document.getElementById('cmd-backdrop')!;
  const cmdInput = document.getElementById('cmd-input') as HTMLInputElement;
  const cmdDynamic = document.getElementById('cmd-dynamic')!;
  const cmdList = document.getElementById('cmd-list')!;
  let paletteOpen = false;
  let searchTimer: ReturnType<typeof setTimeout>;

  function openPalette() {
    backdrop.hidden = false;
    paletteOpen = true;
    cmdInput.value = '';
    cmdInput.focus();
    cmdDynamic.innerHTML = '';
    fetchSuggestions('');
  }

  function closePalette() {
    backdrop.hidden = true;
    paletteOpen = false;
  }

  async function fetchSuggestions(q: string) {
    try {
      const res = await fetch(`/api/admin/search?q=${encodeURIComponent(q)}`);
      if (!res.ok) return;
      const { reports } = await res.json() as { reports: Array<{ id: string; title: string; status: string }> };
      if (reports.length === 0) {
        cmdDynamic.innerHTML = q ? `<div class="cmd-empty">Sin resultados para "${q}"</div>` : '';
        return;
      }
      cmdDynamic.innerHTML =
        `<div class="cmd-section">Reportes</div>` +
        reports.map(r =>
          `<a href="/admin/reports/${r.id}/edit" class="cmd-item" role="option">
            <span class="cmd-item__dot cmd-item__dot--${r.status}"></span>
            <span class="cmd-item__label">${r.title}</span>
            <span class="cmd-item__meta">${r.status === 'published' ? 'Publicado' : r.status === 'draft' ? 'Borrador' : 'Archivado'}</span>
          </a>`
        ).join('');
    } catch {}
  }

  cmdInput.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => fetchSuggestions(cmdInput.value.trim()), 200);
  });

  backdrop.addEventListener('click', (e) => {
    if (e.target === backdrop) closePalette();
  });

  // Arrow key navigation inside palette
  cmdList.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      const items = Array.from(cmdList.querySelectorAll<HTMLElement>('.cmd-item'));
      const focused = cmdList.querySelector<HTMLElement>('.cmd-item.focused');
      const idx = focused ? items.indexOf(focused) : -1;
      focused?.classList.remove('focused');
      const next = e.key === 'ArrowDown'
        ? items[idx + 1] ?? items[0]
        : items[idx - 1] ?? items[items.length - 1];
      next?.classList.add('focused');
      next?.scrollIntoView({ block: 'nearest' });
    }
    if (e.key === 'Enter') {
      const focused = cmdList.querySelector<HTMLAnchorElement>('.cmd-item.focused');
      if (focused) { closePalette(); focused.click(); }
    }
  });

  cmdInput.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      const first = cmdList.querySelector<HTMLElement>('.cmd-item');
      first?.focus();
    }
  });

  // ── Global keyboard shortcuts ───────────────────────────────────────────────
  document.addEventListener('keydown', (e) => {
    const inInput = ['INPUT','TEXTAREA','SELECT'].includes((e.target as HTMLElement).tagName);

    // ⌘K / Ctrl+K → palette
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      paletteOpen ? closePalette() : openPalette();
      return;
    }

    // Escape → close palette or bulk bar
    if (e.key === 'Escape') {
      if (paletteOpen) { closePalette(); return; }
      const bulkBar = document.getElementById('bulk-bar');
      if (bulkBar?.classList.contains('visible')) {
        bulkBar.classList.remove('visible');
        document.querySelectorAll<HTMLInputElement>('.row-check').forEach(cb => { cb.checked = false; });
        const allCb = document.getElementById('check-all') as HTMLInputElement | null;
        if (allCb) allCb.checked = false;
      }
      return;
    }

    // Non-input shortcuts
    if (!inInput && !e.metaKey && !e.ctrlKey && !e.altKey) {
      if (e.key === 'n') { e.preventDefault(); window.location.href = '/admin/reports/new'; }
    }
  });
</script>
