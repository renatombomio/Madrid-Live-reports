---
interface Props {
  title: string;
  user?: { name: string; role?: string | null };
}
const { title, user } = Astro.props;
const path = Astro.url.pathname;
const navActive = (href: string) =>
  href === '/admin' ? path === '/admin' : path.startsWith(href);
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Admin · Madrid Live</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="adm-body">

  <nav class="adm-bar" aria-label="Navegación admin">
    <div class="adm-bar__left">
      <a href="/admin" class="adm-logo">
        MADRIDLIVE
        <span class="adm-logo__tag">ADMIN</span>
      </a>
      <div class="adm-nav">
        <a href="/admin"         class:list={['adm-nav__link', { active: navActive('/admin') }]}>Dashboard</a>
        <a href="/admin/reports" class:list={['adm-nav__link', { active: navActive('/admin/reports') }]}>Reportes</a>
        <a href="/admin/news"    class:list={['adm-nav__link', { active: navActive('/admin/news') }]}>Noticias</a>
      </div>
    </div>
    <div class="adm-bar__right">
      <a href="/" class="adm-viewsite" target="_blank" rel="noopener">Ver sitio →</a>
      {user && <span class="adm-username">{user.name}</span>}
      <form method="POST" action="/api/auth/sign-out" style="display:contents">
        <button type="submit" class="adm-signout">Salir</button>
      </form>
    </div>
  </nav>

  <main class="adm-main">
    <slot />
  </main>

</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --adm-bg:       #f9f8f6;
    --adm-bg2:      #ffffff;
    --adm-bg3:      #f4f2ee;
    --adm-bg4:      #edeae4;
    --adm-border:   #e8e4db;
    --adm-border2:  #d5cfc4;
    --adm-txt:      #1a1714;
    --adm-txt2:     #5a5550;
    --adm-txt3:     #9b8c7e;
    --adm-accent:   #c56b2d;
    --adm-accentbg: #fdf3eb;
    --adm-accentbd: #f0c9a0;
    --adm-green:    #166534;
    --adm-greenbg:  #f0fdf4;
    --adm-greenbd:  #86efac;
    --adm-amber:    #92400e;
    --adm-amberbg:  #fffbeb;
    --adm-amberbd:  #fde68a;
    --adm-red:      #991b1b;
    --adm-redbg:    #fef2f2;
    --adm-redbd:    #fca5a5;
    --adm-radius:   6px;
    --adm-shadow:   0 1px 3px rgba(0,0,0,0.06);
  }

  .adm-body {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    background: var(--adm-bg);
    color: var(--adm-txt);
    min-height: 100vh;
  }

  /* ── Top bar ──────────────────────────────────────────────────────────────── */
  .adm-bar {
    position: sticky; top: 0; z-index: 100;
    background: var(--adm-bg2);
    border-bottom: 1px solid var(--adm-border);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 1.5rem; height: 52px;
    box-shadow: var(--adm-shadow);
  }
  .adm-bar__left  { display: flex; align-items: center; gap: 2rem; }
  .adm-bar__right { display: flex; align-items: center; gap: 1rem; }

  .adm-logo {
    font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 800;
    letter-spacing: 0.1em; color: var(--adm-txt); text-decoration: none;
    display: flex; align-items: center; gap: 8px; white-space: nowrap;
  }
  .adm-logo__tag {
    font-size: 8px; font-weight: 700; letter-spacing: 0.1em;
    background: var(--adm-accent); color: #fff;
    border-radius: 3px; padding: 2px 5px;
  }

  .adm-nav { display: flex; }
  .adm-nav__link {
    font-size: 12px; font-weight: 500; color: var(--adm-txt2);
    text-decoration: none; padding: 0 10px; line-height: 50px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .adm-nav__link:hover { color: var(--adm-txt); }
  .adm-nav__link.active { color: var(--adm-accent); border-bottom-color: var(--adm-accent); }

  .adm-viewsite {
    font-size: 11px; color: var(--adm-txt3); text-decoration: none;
    transition: color 0.15s; white-space: nowrap;
  }
  .adm-viewsite:hover { color: var(--adm-accent); }
  .adm-username { font-size: 12px; color: var(--adm-txt2); white-space: nowrap; }
  .adm-signout {
    font-size: 11px; color: var(--adm-txt3);
    background: none; border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius); padding: 4px 10px;
    cursor: pointer; transition: color 0.15s, border-color 0.15s;
    font-family: inherit;
  }
  .adm-signout:hover { color: var(--adm-txt); border-color: var(--adm-border2); }

  /* ── Main ────────────────────────────────────────────────────────────────── */
  .adm-main { padding: 2rem 1.5rem; max-width: 1140px; margin: 0 auto; }

  /* ── Page header ─────────────────────────────────────────────────────────── */
  .adm-page-header { margin-bottom: 2rem; }
  .adm-breadcrumb {
    font-family: 'Syne', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--adm-txt3);
    display: flex; align-items: center; gap: 7px; margin-bottom: 0.75rem;
  }
  .adm-breadcrumb a { color: var(--adm-txt3); text-decoration: none; transition: color 0.15s; }
  .adm-breadcrumb a:hover { color: var(--adm-accent); }
  .adm-breadcrumb span[aria-hidden] { opacity: 0.4; }
  .adm-page-title {
    font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800;
    letter-spacing: -0.3px; color: var(--adm-txt);
  }

  /* ── Stat card ───────────────────────────────────────────────────────────── */
  .adm-stat {
    background: var(--adm-bg2); border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius); padding: 1.25rem 1.5rem;
    box-shadow: var(--adm-shadow);
  }
  .adm-stat__value {
    font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 800;
    color: var(--adm-txt); line-height: 1; margin-bottom: 0.375rem;
  }
  .adm-stat__value--accent { color: var(--adm-accent); }
  .adm-stat__value--green  { color: var(--adm-green); }
  .adm-stat__value--amber  { color: var(--adm-amber); }
  .adm-stat__label { font-size: 11px; color: var(--adm-txt3); letter-spacing: 0.03em; }
  .adm-stat__sub   { font-size: 10px; color: var(--adm-txt3); margin-top: 4px; }

  /* ── Panel block ─────────────────────────────────────────────────────────── */
  .adm-panel {
    background: var(--adm-bg2); border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius); box-shadow: var(--adm-shadow); overflow: hidden;
  }
  .adm-panel__head {
    font-family: 'Syne', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--adm-txt3);
    padding: 0.875rem 1.25rem 0.625rem;
    border-bottom: 1px solid var(--adm-border);
    display: flex; align-items: center; justify-content: space-between;
  }
  .adm-panel__head a { color: var(--adm-accent); font-size: 11px; text-transform: none; text-decoration: none; letter-spacing: 0; }
  .adm-panel__head a:hover { opacity: 0.75; }

  /* ── Status badges ───────────────────────────────────────────────────────── */
  .adm-badge {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 10px; font-weight: 600; letter-spacing: 0.03em;
    padding: 2px 8px; border-radius: 10px; border: 1px solid;
  }
  .adm-badge--published { color: var(--adm-green);  background: var(--adm-greenbg);  border-color: var(--adm-greenbd); }
  .adm-badge--draft     { color: var(--adm-amber);  background: var(--adm-amberbg);  border-color: var(--adm-amberbd); }
  .adm-badge--archived  { color: var(--adm-txt3);   background: var(--adm-bg3);      border-color: var(--adm-border); }
  .adm-badge__dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }

  /* ── Primary action button ───────────────────────────────────────────────── */
  .adm-btn {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: 'Syne', sans-serif; font-size: 11px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    background: var(--adm-accent); color: #fff; text-decoration: none;
    border: none; border-radius: var(--adm-radius); padding: 8px 16px;
    cursor: pointer; transition: opacity 0.15s; white-space: nowrap;
  }
  .adm-btn:hover { opacity: 0.85; color: #fff; }
  .adm-btn--sm { font-size: 10px; padding: 5px 10px; }
  .adm-btn--ghost {
    background: none; color: var(--adm-txt2); border: 1px solid var(--adm-border);
  }
  .adm-btn--ghost:hover { color: var(--adm-txt); border-color: var(--adm-border2); background: none; opacity: 1; }

  /* ── Table ───────────────────────────────────────────────────────────────── */
  .adm-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .adm-table thead { border-bottom: 1px solid var(--adm-border); background: var(--adm-bg3); }
  .adm-table th {
    text-align: left; padding: 0.625rem 1rem;
    font-family: 'Syne', sans-serif; font-size: 9px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--adm-txt3);
  }
  .adm-table td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--adm-border); vertical-align: middle; }
  .adm-table tbody tr:last-child td { border-bottom: none; }
  .adm-table tbody tr { transition: background 0.12s; }
  .adm-table tbody tr:hover { background: var(--adm-bg3); }

  /* ── Filter tabs ─────────────────────────────────────────────────────────── */
  .adm-tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--adm-border); margin-bottom: 0; }
  .adm-tab {
    font-size: 12px; font-weight: 500; color: var(--adm-txt2);
    text-decoration: none; padding: 10px 14px;
    border-bottom: 2px solid transparent; margin-bottom: -1px;
    transition: color 0.15s, border-color 0.15s; white-space: nowrap;
  }
  .adm-tab:hover { color: var(--adm-txt); }
  .adm-tab.active { color: var(--adm-accent); border-bottom-color: var(--adm-accent); }
  .adm-tab__count {
    font-size: 10px; font-weight: 700; font-family: 'Syne', sans-serif;
    background: var(--adm-bg4); color: var(--adm-txt3);
    border-radius: 8px; padding: 1px 6px; margin-left: 4px;
  }
  .adm-tab.active .adm-tab__count { background: var(--adm-accentbg); color: var(--adm-accent); }

  /* ── Inline action links ─────────────────────────────────────────────────── */
  .adm-action {
    font-size: 11px; color: var(--adm-txt3); text-decoration: none;
    padding: 3px 7px; border-radius: 4px; border: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
    white-space: nowrap; cursor: pointer; background: none;
    font-family: inherit; font-size: 11px;
  }
  .adm-action:hover { color: var(--adm-txt); border-color: var(--adm-border); background: var(--adm-bg3); }
  .adm-action--publish { color: var(--adm-accent); }
  .adm-action--publish:hover { border-color: var(--adm-accentbd); background: var(--adm-accentbg); color: var(--adm-accent); }
  .adm-action--danger:hover  { color: var(--adm-red);   border-color: var(--adm-redbd);   background: var(--adm-redbg); }

  /* ── Empty state ─────────────────────────────────────────────────────────── */
  .adm-empty {
    padding: 3.5rem 1.5rem; text-align: center;
    border: 1px dashed var(--adm-border2); border-radius: var(--adm-radius);
  }
  .adm-empty__msg  { font-size: 13px; color: var(--adm-txt3); margin-bottom: 1rem; }

  /* ── Signal row (editorial signals) ─────────────────────────────────────── */
  .adm-signal-row {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--adm-border);
    transition: background 0.12s;
  }
  .adm-signal-row:last-child { border-bottom: none; }
  .adm-signal-row:hover { background: var(--adm-bg3); }
  .adm-signal-icon { font-size: 12px; flex-shrink: 0; margin-top: 1px; }
  .adm-signal-body { flex: 1; min-width: 0; }
  .adm-signal-label { font-size: 12px; color: var(--adm-txt2); line-height: 1.4; }
  .adm-signal-label a { color: var(--adm-txt2); text-decoration: none; }
  .adm-signal-label a:hover { color: var(--adm-accent); }
  .adm-signal-meta  { font-size: 11px; color: var(--adm-txt3); margin-top: 1px; }

  /* ── Activity row ────────────────────────────────────────────────────────── */
  .adm-activity-row {
    display: flex; align-items: center; gap: 12px;
    padding: 0.65rem 1.25rem; border-bottom: 1px solid var(--adm-border);
    text-decoration: none; transition: background 0.12s;
  }
  .adm-activity-row:last-child { border-bottom: none; }
  .adm-activity-row:hover { background: var(--adm-bg3); }
  .adm-activity-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--adm-accent); flex-shrink: 0;
  }
  .adm-activity-title { font-size: 12px; color: var(--adm-txt); font-weight: 500; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .adm-activity-meta  { font-size: 11px; color: var(--adm-txt3); white-space: nowrap; flex-shrink: 0; }

  /* ── Category bar ────────────────────────────────────────────────────────── */
  .adm-catbar-row {
    display: flex; align-items: center; gap: 12px;
    padding: 0.6rem 1.25rem; border-bottom: 1px solid var(--adm-border);
  }
  .adm-catbar-row:last-child { border-bottom: none; }
  .adm-catbar-name { font-size: 12px; color: var(--adm-txt2); width: 110px; flex-shrink: 0; }
  .adm-catbar-track { flex: 1; height: 4px; background: var(--adm-border); border-radius: 2px; }
  .adm-catbar-fill  { height: 100%; border-radius: 2px; background: var(--adm-accent); }
  .adm-catbar-count { font-family: 'Syne', sans-serif; font-size: 11px; font-weight: 700; color: var(--adm-txt3); width: 24px; text-align: right; flex-shrink: 0; }
</style>
