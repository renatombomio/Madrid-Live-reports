---
type IconKey = 'reports' | 'news' | 'districts' | 'search' | 'default';

interface Props {
  title?: string;
  message?: string;
  action?: { label: string; href: string };
  icon?: IconKey;
}

const {
  title = 'Sin contenido',
  message = 'No hay elementos disponibles todavía.',
  action,
  icon = 'default',
} = Astro.props;

const icons: Record<IconKey, string> = {
  reports:   `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>`,
  news:      `<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 0-2 2zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><line x1="18" y1="14" x2="12" y2="14"/><line x1="18" y1="18" x2="12" y2="18"/><path d="M10 6h8v4h-8z"/>`,
  districts: `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
  search:    `<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>`,
  default:   `<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>`,
};
---

<div class="empty-state">
  <div class="empty-state__icon" aria-hidden="true">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon]} />
  </div>
  <h3 class="empty-state__title syne">{title}</h3>
  <p class="empty-state__msg">{message}</p>
  {action && (
    <a href={action.href} class="empty-state__cta">{action.label} →</a>
  )}
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 2rem;
    text-align: center;
    gap: 0.75rem;
  }
  .empty-state__icon {
    width: 64px; height: 64px;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg4);
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--txt3);
    margin-bottom: 0.5rem;
  }
  .empty-state__title {
    font-family: 'Syne', sans-serif;
    font-size: 16px; font-weight: 700;
    color: var(--txt2);
    letter-spacing: -0.2px;
  }
  .empty-state__msg {
    font-size: 13px;
    color: var(--txt3);
    line-height: 1.6;
    max-width: 320px;
  }
  .empty-state__cta {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 12px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accentbd);
    padding-bottom: 1px;
    transition: opacity 0.15s;
  }
  .empty-state__cta:hover { opacity: 0.75; }
</style>
