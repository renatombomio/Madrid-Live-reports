---
interface Props {
  id: string;
  title: string;
  slug: string;
  summary: string;
  coverImage?: string | null;
  publishedAt?: Date | null;
  authorName: string;
  source?: string | null;
  districtName?: string | null;
}

const { title, slug, summary, coverImage, publishedAt, authorName, source, districtName } =
  Astro.props;

function fmtDate(d?: Date | null) {
  if (!d) return '';
  const diff = Math.floor((Date.now() - d.getTime()) / 60000);
  if (diff < 1) return 'Ahora mismo';
  if (diff < 60) return `Hace ${diff} min`;
  if (diff < 1440) return `Hace ${Math.floor(diff / 60)}h`;
  return d.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
}
---

<article class="nc card-hover">
  <a href={`/news/${slug}`} class="nc__link" aria-label={title}>
    {coverImage && (
      <img src={coverImage} alt={title} class="nc__img" />
    )}
    <div class="nc__body">
      <div class="nc__chips">
        {source && <span class="nc__source">{source}</span>}
        {districtName && <span class="nc__district">{districtName}</span>}
      </div>
      <h3 class="nc__title syne">{title}</h3>
      <p class="nc__excerpt">{summary}</p>
      <div class="nc__footer">
        <span class="nc__author">{authorName}</span>
        {publishedAt && <time class="nc__time">{fmtDate(publishedAt)}</time>}
      </div>
    </div>
  </a>
</article>

<style>
  .nc { border-bottom: 1px solid var(--border); background: var(--bg); }
  .nc:last-child { border-bottom: none; }
  .nc__link {
    display: flex;
    gap: 1rem;
    padding: 1rem 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }
  .nc:hover .nc__link { background: var(--bg3); }
  .nc__img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border2);
    flex-shrink: 0;
  }
  .nc__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .nc__chips { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 2px; }
  .nc__source {
    background: var(--accentbg);
    border: 1px solid var(--accentbd);
    color: var(--accent);
    font-family: 'Syne', sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 1px 6px;
    border-radius: 4px;
  }
  .nc__district {
    background: var(--bg4);
    border: 1px solid var(--border2);
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 9px;
    color: var(--txt2);
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .nc__title {
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--txt);
    line-height: 1.35;
    transition: color 0.15s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .nc:hover .nc__title { color: var(--accent); }
  .nc__excerpt {
    font-size: 12px;
    color: var(--txt3);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .nc__footer { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
  .nc__author { font-size: 11px; color: var(--txt3); }
  .nc__time { font-size: 11px; color: var(--txt3); }
</style>
