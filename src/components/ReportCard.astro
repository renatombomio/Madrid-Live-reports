---
interface Props {
  title: string; excerpt?: string; slug: string;
  district?: string; tags?: string[];
  publishedAt?: Date | string; views?: number;
}
const { title, excerpt, slug, district, tags = [], publishedAt, views } = Astro.props;
const tagClass: Record<string, string> = {
  // raw category enum keys
  urban_development: 'tag-obras',   transport:  'tag-trafico',
  culture:           'tag-cultura', environment:'tag-obras',
  economy:           'tag-trafico', safety:     'tag-urgente',
  health:            'tag-urgente', education:  'tag-cultura',
  tourism:           'tag-trafico', general:    'tag-obras',
  // Spanish display names
  urbanismo:         'tag-obras',   transporte: 'tag-trafico',
  cultura:           'tag-cultura', economía:   'tag-trafico',
  seguridad:         'tag-urgente', salud:      'tag-urgente',
  educación:         'tag-cultura', turismo:    'tag-trafico',
  // legacy / misc
  urgente: 'tag-urgente', tráfico: 'tag-trafico', trafico: 'tag-trafico',
  obras:   'tag-obras',   alerta:  'tag-alerta',
};
function fmtDate(d?: Date | string) {
  if (!d) return '';
  const date = typeof d === 'string' ? new Date(d) : d;
  const diff = Math.floor((Date.now() - date.getTime()) / 60000);
  if (diff < 1) return 'Ahora mismo';
  if (diff < 60) return `Hace ${diff} min`;
  if (diff < 1440) return `Hace ${Math.floor(diff / 60)}h`;
  return date.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
}
---
<article class="rc card-hover">
  <a href={`/reports/${slug}`} class="rc__link" aria-label={title}>
    <div class="rc__body">
      {tags.length > 0 && (
        <div class="rc__tags">
          {tags.map(tag => <span class={`tag ${tagClass[tag.toLowerCase()] ?? 'tag-obras'}`}>{tag}</span>)}
        </div>
      )}
      <h2 class="rc__title syne">{title}</h2>
      {excerpt && <p class="rc__excerpt">{excerpt}</p>}
      <div class="rc__meta">
        {district && <span class="district-chip">{district}</span>}
        {publishedAt && <Fragment><span aria-hidden="true">·</span><time>{fmtDate(publishedAt)}</time></Fragment>}
        {views !== undefined && <Fragment><span aria-hidden="true">·</span><span>{views >= 1000 ? `${(views/1000).toFixed(1)}k` : views} vistas</span></Fragment>}
      </div>
    </div>
    <div class="rc__icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
    </div>
  </a>
</article>
<style>
  .rc { border-bottom: 1px solid var(--border); background: var(--bg); }
  .rc:last-child { border-bottom: none; }
  .rc__link { display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: start; padding: 1.25rem 1.5rem; text-decoration: none; color: inherit; }
  .rc__tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .rc__title { font-size: 15px; font-weight: 700; line-height: 1.35; color: var(--txt); margin-bottom: 0.4rem; transition: color 0.15s; }
  .rc:hover .rc__title { color: var(--accent); }
  .rc__excerpt { font-size: 12px; color: var(--txt2); line-height: 1.6; margin-bottom: 0.6rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .rc__meta { display: flex; align-items: center; gap: 7px; font-size: 11px; color: var(--txt3); flex-wrap: wrap; }
  .district-chip { background: var(--bg4); border: 1px solid var(--border2); border-radius: 4px; padding: 2px 7px; font-size: 10px; color: var(--txt2); font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: 0.04em; }
  .rc__icon { width: 48px; height: 48px; background: var(--bg4); border: 1px solid var(--border); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; color: var(--txt3); flex-shrink: 0; transition: border-color 0.15s; }
  .rc:hover .rc__icon { border-color: var(--border3); }
</style>
