---
interface Props {
  id: string;
  title: string;
  slug: string;
  summary: string;
  category: string;
  coverImage?: string | null;
  publishedAt?: Date | null;
  authorName: string;
  districtName?: string | null;
}

const { title, slug, summary, category, coverImage, publishedAt, authorName, districtName } =
  Astro.props;

const date = publishedAt
  ? new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium' }).format(publishedAt)
  : null;
---

<article class="bg-white rounded-card border border-gray-100 shadow-sm hover:shadow-md transition-shadow overflow-hidden">
  {coverImage && (
    <img src={coverImage} alt={title} class="w-full h-48 object-cover" />
  )}
  <div class="p-5">
    <div class="flex items-center gap-2 mb-2 text-xs text-gray-500">
      <span class="bg-madrid-red/10 text-madrid-red font-medium px-2 py-0.5 rounded">
        {category.replace('_', ' ')}
      </span>
      {districtName && <span class="text-gray-400">· {districtName}</span>}
    </div>
    <h3 class="font-serif text-lg font-bold mb-2 leading-snug">
      <a href={`/reports/${slug}`} class="hover:text-madrid-red transition-colors no-underline text-madrid-dark">
        {title}
      </a>
    </h3>
    <p class="text-sm text-gray-600 line-clamp-3 mb-4">{summary}</p>
    <div class="flex items-center justify-between text-xs text-gray-400">
      <span>{authorName}</span>
      {date && <time datetime={publishedAt?.toISOString()}>{date}</time>}
    </div>
  </div>
</article>
