---
import PublicDashboardLayout from '../../layouts/PublicDashboardLayout.astro';
import { db } from '../../db';
import { districts, reports } from '../../db/schema';
import { eq, asc, sql, and } from 'drizzle-orm';

const districtStats = await db
  .select({
    id: districts.id,
    name: districts.name,
    slug: districts.slug,
    description: districts.description,
    reportCount: sql<number>`count(${reports.id})`.mapWith(Number),
  })
  .from(districts)
  .leftJoin(reports, and(eq(districts.id, reports.districtId), eq(reports.status, 'published')))
  .groupBy(districts.id, districts.name, districts.slug, districts.description)
  .orderBy(asc(districts.name));

const maxCount = Math.max(...districtStats.map(d => d.reportCount), 1);
---

<PublicDashboardLayout title="Distritos de Madrid" description="Explora los 21 distritos de Madrid y sus reportes.">
  <div class="page-head">
    <h1 class="page-title syne">Distritos</h1>
    <span class="page-count">{districtStats.length} distritos</span>
  </div>

  {districtStats.length > 0 ? (
    <div class="districts-grid">
      {districtStats.map(district => (
        <a href={`/districts/${district.slug}`} class="district-card card-hover">
          <div class="district-card__body">
            <div class="district-card__name syne">{district.name}</div>
            {district.description && (
              <p class="district-card__desc">{district.description}</p>
            )}
            <div class="district-card__footer">
              <span class="district-card__count">{district.reportCount} reportes</span>
              <div class="dist-bar" style={`width: 80px;`}>
                <div
                  class="dist-bar-fill"
                  style={`width: ${Math.round((district.reportCount / maxCount) * 100)}%`}
                ></div>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <p>No hay distritos disponibles.</p>
    </div>
  )}
</PublicDashboardLayout>

<style>
  .page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .page-title {
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--txt2);
  }
  .page-count { font-size: 11px; color: var(--txt3); }
  .districts-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--border);
  }
  .district-card {
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    background: var(--bg);
    display: block;
  }
  .district-card:nth-child(4n) { border-right: none; }
  .district-card__body { padding: 1.25rem 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; height: 100%; }
  .district-card__name {
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--txt);
    transition: color 0.15s;
  }
  .district-card:hover .district-card__name { color: var(--accent); }
  .district-card__desc {
    font-size: 12px;
    color: var(--txt3);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .district-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .district-card__count { font-size: 11px; color: var(--txt3); }
  .empty-state {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1.5rem;
    color: var(--txt3);
    font-size: 14px;
  }
  @media (max-width: 1024px) {
    .districts-grid { grid-template-columns: repeat(2, 1fr); }
    .district-card:nth-child(4n) { border-right: 1px solid var(--border); }
    .district-card:nth-child(2n) { border-right: none; }
  }
  @media (max-width: 600px) {
    .districts-grid { grid-template-columns: 1fr; }
    .district-card:nth-child(n) { border-right: none; }
  }
</style>
