---
import PublicDashboardLayout from '../../layouts/PublicDashboardLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { db } from '../../db';
import { news, user, districts } from '../../db/schema';
import { eq, and } from 'drizzle-orm';

const { slug } = Astro.params;

if (!slug) return Astro.redirect('/news');

const [item] = await db
  .select({
    id:          news.id,
    title:       news.title,
    slug:        news.slug,
    summary:     news.summary,
    content:     news.content,
    coverImage:  news.coverImage,
    publishedAt: news.publishedAt,
    source:      news.source,
    sourceUrl:   news.sourceUrl,
    authorName:  user.name,
    districtName: districts.name,
  })
  .from(news)
  .innerJoin(user, eq(news.authorId, user.id))
  .leftJoin(districts, eq(news.districtId, districts.id))
  .where(and(eq(news.slug, slug), eq(news.status, 'published')))
  .limit(1);

if (!item) return Astro.redirect('/news', 307);

const formattedDate = item.publishedAt
  ? new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' }).format(item.publishedAt)
  : null;
---

<PublicDashboardLayout
  title={item.title}
  description={item.summary}
  ogImage={item.coverImage ?? undefined}
  showTicker={false}
>
  <div class="article-layout">
    <article class="article">
      {item.coverImage && (
        <img src={item.coverImage} alt={item.title} class="article__cover" />
      )}
      <div class="article__body">
        <nav class="article__breadcrumb syne" aria-label="Navegación de ruta">
          <a href="/">Madrid Live</a>
          <span aria-hidden="true">/</span>
          <a href="/news">Noticias</a>
          <span aria-hidden="true">/</span>
          <span>{item.title.length > 40 ? item.title.slice(0, 40) + '…' : item.title}</span>
        </nav>

        <div class="article__meta">
          {item.source && <span class="article__source">{item.source}</span>}
          {item.districtName && <span class="article__district">{item.districtName}</span>}
          {formattedDate && <time class="article__date">{formattedDate}</time>}
        </div>

        <h1 class="article__title syne">{item.title}</h1>
        <p class="article__summary">{item.summary}</p>
        <p class="article__byline">Por {item.authorName}</p>

        <div class="article-content" set:html={item.content} />

        {item.sourceUrl && (
          <div class="article__source-box">
            Fuente original:
            <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
              {item.source ?? item.sourceUrl}
            </a>
          </div>
        )}

        <div class="article__back">
          <a href="/news">← Volver a noticias</a>
        </div>
      </div>
    </article>
    <Sidebar />
  </div>
</PublicDashboardLayout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    border-top: 1px solid var(--border);
    min-height: 60vh;
  }
  .article { border-right: 1px solid var(--border); }
  .article__cover { width: 100%; max-height: 360px; object-fit: cover; }
  .article__body { padding: 2.5rem 2rem; max-width: 720px; }

  .article__breadcrumb {
    display: flex; align-items: center; gap: 8px;
    font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--txt3); margin-bottom: 1.75rem;
  }
  .article__breadcrumb a { color: var(--txt3); text-decoration: none; transition: color 0.15s; }
  .article__breadcrumb a:hover { color: var(--accent); }

  .article__meta {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .article__source {
    background: var(--accentbg); border: 1px solid var(--accentbd); color: var(--accent);
    font-family: 'Syne', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 8px; border-radius: 4px;
  }
  .article__district {
    background: var(--bg4); border: 1px solid var(--border2); border-radius: 4px;
    padding: 2px 7px; font-size: 10px; color: var(--txt2);
    font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: 0.04em;
  }
  .article__date { font-size: 12px; color: var(--txt3); }

  .article__title {
    font-size: clamp(22px, 3.5vw, 34px); font-weight: 800;
    letter-spacing: -0.5px; color: var(--txt);
    margin-bottom: 1rem; line-height: 1.2;
  }
  .article__summary {
    font-size: 16px; font-weight: 300; color: var(--txt2);
    line-height: 1.75; margin-bottom: 0.5rem;
    border-left: 3px solid var(--border2); padding-left: 1rem;
  }
  .article__byline { font-size: 12px; color: var(--txt3); margin-bottom: 2.5rem; }

  .article__source-box {
    margin-top: 2.5rem; padding: 1rem 1.25rem;
    background: var(--bg3); border: 1px solid var(--border2);
    border-radius: var(--radius-sm); font-size: 13px; color: var(--txt3);
  }
  .article__source-box a { color: var(--accent); margin-left: 4px; text-decoration: none; }
  .article__source-box a:hover { opacity: 0.8; }

  .article__back {
    margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
  }
  .article__back a {
    font-size: 13px; color: var(--txt3); text-decoration: none; transition: color 0.15s;
  }
  .article__back a:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .article-layout { grid-template-columns: 1fr; }
    .article { border-right: none; }
    .article__body { padding: 2rem 1.25rem; }
  }
</style>
