---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { db } from '../../db';
import { news, user, districts } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

const allNews = await db
  .select({
    id: news.id,
    title: news.title,
    slug: news.slug,
    summary: news.summary,
    coverImage: news.coverImage,
    publishedAt: news.publishedAt,
    authorName: user.name,
    source: news.source,
    districtName: districts.name,
  })
  .from(news)
  .innerJoin(user, eq(news.authorId, user.id))
  .leftJoin(districts, eq(news.districtId, districts.id))
  .where(eq(news.status, 'published'))
  .orderBy(desc(news.publishedAt));
---

<BaseLayout title="Noticias" description="Últimas noticias de Madrid.">
  <h1 class="text-4xl font-bold mb-2">Noticias</h1>
  <p class="text-gray-500 mb-10">Últimas noticias de la ciudad de Madrid.</p>

  {allNews.length > 0 ? (
    <div class="flex flex-col gap-3 max-w-2xl">
      {allNews.map((item) => (
        <NewsCard {...item} />
      ))}
    </div>
  ) : (
    <p class="text-gray-400 text-center py-24">No hay noticias publicadas todavía.</p>
  )}
</BaseLayout>
