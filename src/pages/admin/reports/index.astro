---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { auth } from '../../../lib/auth';
import { getAdminReportsList } from '../../../lib/data/admin-queries';
import { CATEGORY_DISPLAY } from '../../../lib/content-labels';
import { fmtRelative } from '../../../lib/format';

const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session || session.user.role === 'viewer') return Astro.redirect('/admin/login');

const statusFilter = Astro.url.searchParams.get('status') || 'all';
const { rows: allReports, counts } = await getAdminReportsList(
  statusFilter !== 'all' ? statusFilter : undefined,
);

const fmt = new Intl.DateTimeFormat('es-ES', { dateStyle: 'short', timeStyle: 'short' });
const tabUrl = (s: string) => s === 'all' ? '/admin/reports' : `/admin/reports?status=${s}`;
---

<AdminLayout title="Reportes" user={session.user}>

  <div class="adm-page-header">
    <nav class="adm-breadcrumb">
      <a href="/admin">Admin</a>
      <span aria-hidden="true">/</span>
      <span>Reportes</span>
    </nav>
    <div class="rp-head">
      <h1 class="adm-page-title">Reportes</h1>
      <a href="/admin/reports/new" class="adm-btn">+ Nuevo reporte</a>
    </div>
  </div>

  <div class="adm-panel">
    <!-- Filter tabs -->
    <div class="adm-tabs">
      <a href={tabUrl('all')}       class:list={['adm-tab', { active: statusFilter === 'all' }]}>
        Todos <span class="adm-tab__count">{counts.all}</span>
      </a>
      <a href={tabUrl('published')} class:list={['adm-tab', { active: statusFilter === 'published' }]}>
        Publicados <span class="adm-tab__count">{counts.published}</span>
      </a>
      <a href={tabUrl('draft')}     class:list={['adm-tab', { active: statusFilter === 'draft' }]}>
        Borradores <span class="adm-tab__count">{counts.draft}</span>
      </a>
      <a href={tabUrl('archived')}  class:list={['adm-tab', { active: statusFilter === 'archived' }]}>
        Archivados <span class="adm-tab__count">{counts.archived}</span>
      </a>
    </div>

    {allReports.length === 0 ? (
      <div class="adm-panel-empty" style="padding: 3rem 1.25rem; text-align: center;">
        <p style="color: var(--adm-txt3); margin-bottom: 1rem;">
          {statusFilter === 'all' ? 'No hay reportes todavía.' : `No hay reportes ${statusFilter === 'published' ? 'publicados' : statusFilter === 'draft' ? 'en borrador' : 'archivados'}.`}
        </p>
        {statusFilter === 'all' && <a href="/admin/reports/new" class="adm-btn adm-btn--sm">Crear el primero →</a>}
      </div>
    ) : (
      <div class="rp-table-wrap">
        <table class="adm-table">
          <thead>
            <tr>
              <th>Título</th>
              <th class="col-cat">Categoría</th>
              <th>Estado</th>
              <th class="col-date">Actualizado</th>
              <th class="col-actions"></th>
            </tr>
          </thead>
          <tbody>
            {allReports.map(report => (
              <tr data-id={report.id} data-status={report.status}>
                <td>
                  <div class="rp-title">{report.title}</div>
                  <div class="rp-meta">
                    {report.districtName && <span>{report.districtName}</span>}
                    {report.authorName && <span>{report.authorName}</span>}
                    {report.publishedAt && report.status === 'published' && (
                      <span>Publicado {fmtRelative(report.publishedAt)}</span>
                    )}
                  </div>
                </td>
                <td class="col-cat">
                  <span class="rp-cat" style={`--cat: ${CATEGORY_DISPLAY[report.category]?.color ?? 'var(--adm-txt3)'}`}>
                    {CATEGORY_DISPLAY[report.category]?.name ?? report.category}
                  </span>
                </td>
                <td>
                  <span class={`adm-badge adm-badge--${report.status}`}>
                    <span class="adm-badge__dot"></span>
                    {report.status === 'published' ? 'Publicado' : report.status === 'draft' ? 'Borrador' : 'Archivado'}
                  </span>
                </td>
                <td class="col-date rp-date">{fmt.format(report.updatedAt)}</td>
                <td class="col-actions">
                  <div class="rp-actions">
                    <a href={`/admin/reports/${report.id}/edit`} class="adm-action">Editar</a>
                    <button class="adm-action adm-action--publish publish-btn">
                      {report.status === 'published' ? 'Despublicar' : 'Publicar'}
                    </button>
                    <button class="adm-action adm-action--danger delete-btn">Borrar</button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

</AdminLayout>

<style>
  .rp-head {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
  }
  .rp-table-wrap { overflow-x: auto; }
  .col-cat     { width: 130px; }
  .col-date    { width: 140px; }
  .col-actions { width: 210px; }

  .rp-title { font-size: 13px; font-weight: 600; color: var(--adm-txt); line-height: 1.4; }
  .rp-meta  { display: flex; gap: 8px; margin-top: 2px; font-size: 11px; color: var(--adm-txt3); flex-wrap: wrap; }
  .rp-cat   { font-size: 11px; color: var(--cat, var(--adm-txt3)); font-weight: 500; }
  .rp-date  { font-size: 11px; color: var(--adm-txt3); white-space: nowrap; }
  .rp-actions { display: flex; align-items: center; gap: 4px; justify-content: flex-end; }

  .adm-panel-empty { font-size: 12px; color: var(--adm-txt3); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.publish-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const row = btn.closest('tr') as HTMLTableRowElement;
      const id = row.dataset.id!;
      const currentStatus = row.dataset.status!;
      const nextStatus = currentStatus === 'published' ? 'draft' : 'published';

      btn.textContent = '…';
      btn.disabled = true;

      const res = await fetch(`/api/admin/reports/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: nextStatus }),
      });

      if (res.ok) {
        row.dataset.status = nextStatus;
        const badge = row.querySelector('.adm-badge') as HTMLElement;
        if (badge) {
          badge.className = `adm-badge adm-badge--${nextStatus}`;
          const label = nextStatus === 'published' ? 'Publicado' : nextStatus === 'draft' ? 'Borrador' : 'Archivado';
          badge.innerHTML = `<span class="adm-badge__dot"></span>${label}`;
        }
        btn.textContent = nextStatus === 'published' ? 'Despublicar' : 'Publicar';
      } else {
        alert('No se pudo cambiar el estado.');
        btn.textContent = currentStatus === 'published' ? 'Despublicar' : 'Publicar';
      }
      btn.disabled = false;
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const row = btn.closest('tr') as HTMLTableRowElement;
      const id = row.dataset.id!;
      const title = row.querySelector<HTMLElement>('.rp-title')?.textContent?.trim();

      if (!confirm(`¿Borrar "${title}"? Esta acción no se puede deshacer.`)) return;
      btn.textContent = '…';
      btn.disabled = true;

      const res = await fetch(`/api/admin/reports/${id}`, { method: 'DELETE' });
      if (res.ok) {
        row.style.transition = 'opacity 0.25s';
        row.style.opacity = '0';
        setTimeout(() => row.remove(), 250);
      } else {
        alert('No se pudo borrar.');
        btn.textContent = 'Borrar';
        btn.disabled = false;
      }
    });
  });
</script>
