---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { auth } from '../../../lib/auth';
import { getAdminReportsList } from '../../../lib/data/admin-queries';
import { CATEGORY_DISPLAY } from '../../../lib/content-labels';
import { fmtRelative } from '../../../lib/format';

const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session || session.user.role === 'viewer') return Astro.redirect('/admin/login');

const statusFilter = Astro.url.searchParams.get('status') || 'all';
const { rows: allReports, counts } = await getAdminReportsList(
  statusFilter !== 'all' ? statusFilter : undefined,
);

const fmt = new Intl.DateTimeFormat('es-ES', { dateStyle: 'short', timeStyle: 'short' });
const tabUrl = (s: string) => s === 'all' ? '/admin/reports' : `/admin/reports?status=${s}`;
---

<AdminLayout title="Reportes" user={session.user}>

  <div class="adm-page-header">
    <nav class="adm-breadcrumb">
      <a href="/admin">Admin</a>
      <span aria-hidden="true">/</span>
      <span>Reportes</span>
    </nav>
    <div class="rp-head">
      <h1 class="adm-page-title">Reportes</h1>
      <a href="/admin/reports/new" class="adm-btn">+ Nuevo reporte</a>
    </div>
  </div>

  <div class="adm-panel">
    <!-- Filter tabs -->
    <div class="adm-tabs">
      <a href={tabUrl('all')}       class:list={['adm-tab', { active: statusFilter === 'all' }]}>
        Todos <span class="adm-tab__count">{counts.all}</span>
      </a>
      <a href={tabUrl('published')} class:list={['adm-tab', { active: statusFilter === 'published' }]}>
        Publicados <span class="adm-tab__count">{counts.published}</span>
      </a>
      <a href={tabUrl('draft')}     class:list={['adm-tab', { active: statusFilter === 'draft' }]}>
        Borradores <span class="adm-tab__count">{counts.draft}</span>
      </a>
      <a href={tabUrl('archived')}  class:list={['adm-tab', { active: statusFilter === 'archived' }]}>
        Archivados <span class="adm-tab__count">{counts.archived}</span>
      </a>
    </div>

    {allReports.length === 0 ? (
      <div style="padding: 3rem 1.25rem; text-align: center;">
        <p style="color: var(--adm-txt3); margin-bottom: 1rem; font-size: 13px;">
          {statusFilter === 'all'
            ? 'No hay reportes todavía.'
            : statusFilter === 'published' ? 'No hay reportes publicados.'
            : statusFilter === 'draft'     ? 'No hay borradores.'
            : 'No hay reportes archivados.'}
        </p>
        {statusFilter === 'all' && <a href="/admin/reports/new" class="adm-btn adm-btn--sm">Crear el primero →</a>}
      </div>
    ) : (
      <div class="rp-table-wrap">
        <table class="adm-table">
          <thead>
            <tr>
              <th class="col-check">
                <input type="checkbox" id="check-all" class="adm-check" title="Seleccionar todo" />
              </th>
              <th>Título</th>
              <th class="col-cat">Categoría</th>
              <th>Estado</th>
              <th class="col-date">Actualizado</th>
              <th class="col-actions"></th>
            </tr>
          </thead>
          <tbody>
            {allReports.map(report => (
              <tr data-id={report.id} data-status={report.status}>
                <td class="col-check">
                  <input type="checkbox" class="adm-check row-check" title="Seleccionar" />
                </td>
                <td>
                  <div class="rp-title">{report.title}</div>
                  <div class="rp-meta">
                    {report.districtName && <span>{report.districtName}</span>}
                    {report.authorName && <span>{report.authorName}</span>}
                    {report.publishedAt && report.status === 'published' && (
                      <span>Publicado {fmtRelative(report.publishedAt)}</span>
                    )}
                  </div>
                </td>
                <td class="col-cat">
                  <span class="rp-cat" style={`--cat: ${CATEGORY_DISPLAY[report.category]?.color ?? 'var(--adm-txt3)'}`}>
                    {CATEGORY_DISPLAY[report.category]?.name ?? report.category}
                  </span>
                </td>
                <td>
                  <span class={`adm-badge adm-badge--${report.status}`}>
                    <span class="adm-badge__dot"></span>
                    {report.status === 'published' ? 'Publicado' : report.status === 'draft' ? 'Borrador' : 'Archivado'}
                  </span>
                </td>
                <td class="col-date rp-date">{fmt.format(report.updatedAt)}</td>
                <td class="col-actions">
                  <div class="rp-actions">
                    <a href={`/admin/reports/${report.id}/edit`} class="adm-action">Editar</a>
                    <button class="adm-action adm-action--publish publish-btn">
                      {report.status === 'published' ? 'Despublicar' : 'Publicar'}
                    </button>
                    <button class="adm-action duplicate-btn" title="Duplicar como borrador">Duplicar</button>
                    <button class="adm-action adm-action--danger delete-btn">Borrar</button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <!-- Bulk action bar (shown when items selected) -->
  <div id="bulk-bar" role="toolbar" aria-label="Acciones en lote">
    <span class="bulk-count" id="bulk-count">0 seleccionados</span>
    <button class="bulk-action bulk-action--publish" id="bulk-publish">Publicar</button>
    <button class="bulk-action" id="bulk-archive">Archivar</button>
    <button class="bulk-dismiss" id="bulk-dismiss" aria-label="Cancelar selección">×</button>
  </div>

</AdminLayout>

<style>
  .rp-head {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
  }
  .rp-table-wrap { overflow-x: auto; }
  .col-check   { width: 40px; }
  .col-cat     { width: 120px; }
  .col-date    { width: 140px; }
  .col-actions { width: 240px; }

  .adm-check { accent-color: var(--adm-accent); cursor: pointer; width: 14px; height: 14px; }
  .rp-title { font-size: 13px; font-weight: 600; color: var(--adm-txt); line-height: 1.4; }
  .rp-meta  { display: flex; gap: 8px; margin-top: 2px; font-size: 11px; color: var(--adm-txt3); flex-wrap: wrap; }
  .rp-cat   { font-size: 11px; color: var(--cat, var(--adm-txt3)); font-weight: 500; }
  .rp-date  { font-size: 11px; color: var(--adm-txt3); white-space: nowrap; }
  .rp-actions { display: flex; align-items: center; gap: 4px; justify-content: flex-end; }
</style>

<script>
  const t = (window as any).toast as (msg: string, type?: string) => void;
  const toast = (msg: string, type: string = 'success') => {
    // toast() is defined in AdminLayout — may not be ready yet on first tick
    requestAnimationFrame(() => (window as any).toast?.(msg, type));
  };

  // ── Single publish toggle ───────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.publish-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const row = btn.closest('tr') as HTMLTableRowElement;
      const id = row.dataset.id!;
      const cur = row.dataset.status!;
      const next = cur === 'published' ? 'draft' : 'published';

      btn.textContent = '…'; btn.disabled = true;
      const res = await fetch(`/api/admin/reports/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: next }),
      });
      if (res.ok) {
        row.dataset.status = next;
        const badge = row.querySelector('.adm-badge') as HTMLElement;
        if (badge) {
          badge.className = `adm-badge adm-badge--${next}`;
          badge.innerHTML = `<span class="adm-badge__dot"></span>${next === 'published' ? 'Publicado' : 'Borrador'}`;
        }
        btn.textContent = next === 'published' ? 'Despublicar' : 'Publicar';
        toast(next === 'published' ? 'Publicado correctamente' : 'Movido a borradores');
      } else {
        toast('No se pudo cambiar el estado', 'error');
        btn.textContent = cur === 'published' ? 'Despublicar' : 'Publicar';
      }
      btn.disabled = false;
    });
  });

  // ── Duplicate ───────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.duplicate-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const row = btn.closest('tr') as HTMLTableRowElement;
      const id = row.dataset.id!;
      btn.textContent = '…'; btn.disabled = true;
      const res = await fetch('/api/admin/reports/duplicate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id }),
      });
      if (res.ok) {
        const { id: newId } = await res.json() as { id: string };
        toast('Copia creada como borrador');
        window.location.href = `/admin/reports/${newId}/edit`;
      } else {
        toast('No se pudo duplicar', 'error');
        btn.textContent = 'Duplicar'; btn.disabled = false;
      }
    });
  });

  // ── Delete ──────────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const row = btn.closest('tr') as HTMLTableRowElement;
      const id = row.dataset.id!;
      const title = row.querySelector<HTMLElement>('.rp-title')?.textContent?.trim();
      if (!confirm(`¿Borrar "${title}"? Esta acción no se puede deshacer.`)) return;
      btn.textContent = '…'; btn.disabled = true;
      const res = await fetch(`/api/admin/reports/${id}`, { method: 'DELETE' });
      if (res.ok) {
        row.style.transition = 'opacity 0.2s';
        row.style.opacity = '0';
        setTimeout(() => { row.remove(); updateBulkCount(); }, 200);
        toast('Reporte borrado');
      } else {
        toast('No se pudo borrar', 'error');
        btn.textContent = 'Borrar'; btn.disabled = false;
      }
    });
  });

  // ── Bulk select ─────────────────────────────────────────────────────────────
  const bulkBar   = document.getElementById('bulk-bar')!;
  const bulkCount = document.getElementById('bulk-count')!;
  const checkAll  = document.getElementById('check-all') as HTMLInputElement | null;

  function getSelected() {
    return Array.from(document.querySelectorAll<HTMLInputElement>('.row-check:checked'))
      .map(cb => (cb.closest('tr') as HTMLTableRowElement).dataset.id!)
      .filter(Boolean);
  }

  function updateBulkCount() {
    const n = getSelected().length;
    bulkCount.textContent = `${n} ${n === 1 ? 'seleccionado' : 'seleccionados'}`;
    bulkBar.classList.toggle('visible', n > 0);
  }

  document.querySelectorAll<HTMLInputElement>('.row-check').forEach(cb => {
    cb.addEventListener('change', updateBulkCount);
  });

  checkAll?.addEventListener('change', () => {
    document.querySelectorAll<HTMLInputElement>('.row-check').forEach(cb => {
      cb.checked = checkAll.checked;
    });
    updateBulkCount();
  });

  document.getElementById('bulk-dismiss')?.addEventListener('click', () => {
    document.querySelectorAll<HTMLInputElement>('.row-check').forEach(cb => { cb.checked = false; });
    if (checkAll) checkAll.checked = false;
    updateBulkCount();
  });

  async function bulkAction(action: 'publish' | 'archive') {
    const ids = getSelected();
    if (ids.length === 0) return;
    const label = action === 'publish' ? 'Publicando…' : 'Archivando…';
    const btn = action === 'publish'
      ? document.getElementById('bulk-publish') as HTMLButtonElement
      : document.getElementById('bulk-archive') as HTMLButtonElement;
    btn.textContent = label; btn.disabled = true;

    const res = await fetch('/api/admin/reports/bulk', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids, action }),
    });
    if (res.ok) {
      toast(`${ids.length} ${ids.length === 1 ? 'reporte' : 'reportes'} ${action === 'publish' ? 'publicados' : 'archivados'}`);
      window.location.reload();
    } else {
      toast('Error en la operación', 'error');
      btn.textContent = action === 'publish' ? 'Publicar' : 'Archivar';
      btn.disabled = false;
    }
  }

  document.getElementById('bulk-publish')?.addEventListener('click', () => bulkAction('publish'));
  document.getElementById('bulk-archive')?.addEventListener('click', () => bulkAction('archive'));
</script>
