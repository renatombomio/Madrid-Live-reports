---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import ReportForm from '../../../../components/admin/ReportForm.astro';
import { auth } from '../../../../lib/auth';
import { db } from '../../../../db';
import { reports, districts, tags, reportTags } from '../../../../db/schema';
import { eq, asc } from 'drizzle-orm';

const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session || session.user.role === 'viewer') return Astro.redirect('/admin/login');

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/reports');

const [[report], existingTags, districtList, tagList] = await Promise.all([
  db.select().from(reports).where(eq(reports.id, id)).limit(1),
  db.select({ tagId: reportTags.tagId }).from(reportTags).where(eq(reportTags.reportId, id)),
  db.select().from(districts).orderBy(asc(districts.name)),
  db.select().from(tags).orderBy(asc(tags.name)),
]);

if (!report) return Astro.redirect('/admin/reports');

const reportWithTags = { ...report, tagIds: existingTags.map((t) => t.tagId) };
---

<AdminLayout title={`Editar: ${report.title}`} user={session.user}>
  <div class="adm-page-header">
    <nav class="adm-breadcrumb">
      <a href="/admin">Admin</a>
      <span aria-hidden="true">/</span>
      <a href="/admin/reports">Reportes</a>
      <span aria-hidden="true">/</span>
      <span>{report.title.length > 40 ? report.title.slice(0, 40) + '…' : report.title}</span>
    </nav>
    <h1 class="adm-page-title">Editar reporte</h1>
  </div>
  <ReportForm mode="edit" report={reportWithTags} districts={districtList} tags={tagList} />
</AdminLayout>
