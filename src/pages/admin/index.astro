---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { auth } from '../../lib/auth';
import { db } from '../../db';
import { reports, news } from '../../db/schema';
import { count, eq } from 'drizzle-orm';

// Auth guard — redirect unauthenticated users to login
const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session) return Astro.redirect('/admin/login');

// Only admins and editors reach this page
if (session.user.role === 'viewer') return Astro.redirect('/');

const [[reportCounts], [newsCounts]] = await Promise.all([
  db
    .select({
      published: count(eq(reports.status, 'published')),
      draft: count(eq(reports.status, 'draft')),
    })
    .from(reports),
  db
    .select({
      published: count(eq(news.status, 'published')),
      draft: count(eq(news.status, 'draft')),
    })
    .from(news),
]);
---

<BaseLayout title="Admin">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-3xl font-bold">Panel de administración</h1>
      <span class="text-sm text-gray-500">
        Bienvenido, <strong>{session.user.name}</strong> ({session.user.role})
      </span>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      {[
        { label: 'Informes publicados', value: reportCounts?.published ?? 0, color: 'green' },
        { label: 'Informes en borrador', value: reportCounts?.draft ?? 0, color: 'yellow' },
        { label: 'Noticias publicadas', value: newsCounts?.published ?? 0, color: 'green' },
        { label: 'Noticias en borrador', value: newsCounts?.draft ?? 0, color: 'yellow' },
      ].map(({ label, value, color }) => (
        <div class="bg-white rounded-card border border-gray-100 p-5">
          <p class="text-3xl font-bold mb-1">{value}</p>
          <p class="text-sm text-gray-500">{label}</p>
        </div>
      ))}
    </div>

    <!-- Quick actions -->
    <h2 class="text-xl font-semibold mb-4">Acciones rápidas</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a
        href="/admin/reports/new"
        class="flex items-center gap-3 bg-white border border-gray-100 rounded-card p-5 hover:border-madrid-red transition-colors no-underline group"
      >
        <span class="text-2xl">📝</span>
        <div>
          <p class="font-medium text-madrid-dark group-hover:text-madrid-red">Nuevo informe</p>
          <p class="text-sm text-gray-400">Crear un análisis en profundidad</p>
        </div>
      </a>
      <a
        href="/admin/news/new"
        class="flex items-center gap-3 bg-white border border-gray-100 rounded-card p-5 hover:border-madrid-red transition-colors no-underline group"
      >
        <span class="text-2xl">📰</span>
        <div>
          <p class="font-medium text-madrid-dark group-hover:text-madrid-red">Nueva noticia</p>
          <p class="text-sm text-gray-400">Publicar una actualización de actualidad</p>
        </div>
      </a>
    </div>
  </div>
</BaseLayout>
